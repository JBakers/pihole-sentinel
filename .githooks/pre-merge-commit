#!/bin/bash
#
# Pre-merge-commit hook to prevent AI agents from merging to protected branches
# This hook ensures ONLY the repository owner can merge to main
#
# INSTALLATION:
# cp .githooks/pre-merge-commit .git/hooks/pre-merge-commit
# chmod +x .git/hooks/pre-merge-commit
#
# OR use git config:
# git config core.hooksPath .githooks
#
# CRITICAL RULE from CLAUDE.md:
# - Only the repository owner may merge to main
# - AI agents (Claude, Copilot, etc.) may ONLY commit to the develop branch
#

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Get current branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# Protected branches that ONLY the user may merge to
PROTECTED_BRANCHES=("main")

# Check if current branch is protected
for PROTECTED in "${PROTECTED_BRANCHES[@]}"; do
    if [[ "$CURRENT_BRANCH" == "$PROTECTED" ]]; then
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}  MERGE BLOCKED: Protected branch${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${RED}ERROR: Cannot merge into '$CURRENT_BRANCH'${NC}"
        echo ""
        echo -e "${YELLOW}CRITICAL RULE from CLAUDE.md:${NC}"
        echo -e "  - Only the repository owner may merge into main"
        echo -e "  - AI agents may only commit to develop"
        echo ""

        # Try to detect merge source
        if git rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1; then
            MERGE_SOURCE=$(git rev-parse --abbrev-ref MERGE_HEAD 2>/dev/null || echo "unknown")
            echo -e "${CYAN}Attempted merge: '$MERGE_SOURCE' -> '$CURRENT_BRANCH'${NC}"
            echo ""
        fi

        echo -e "${YELLOW}If you are the repository owner:${NC}"
        echo -e "  1. This hook prevents accidental agent merges"
        echo -e "  2. Override it with: ${CYAN}git merge --no-verify [branch]${NC}"
        echo ""
        echo -e "${YELLOW}If you are an AI agent:${NC}"
        echo -e "  - Abort the merge: ${CYAN}git merge --abort${NC}"
        echo -e "  - Switch to develop: ${CYAN}git switch develop${NC}"
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        exit 1
    fi
done

# Additional check: Detect if this is actually a merge commit
if git rev-parse -q --verify MERGE_HEAD > /dev/null 2>&1; then
    MERGE_SOURCE=$(git rev-parse --abbrev-ref MERGE_HEAD 2>/dev/null || echo "unknown")

    # Double-check we're not merging to protected branches
    for PROTECTED in "${PROTECTED_BRANCHES[@]}"; do
        if [[ "$CURRENT_BRANCH" == "$PROTECTED" ]]; then
            echo ""
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo -e "${RED}  MERGE DETECTED: Protected branch${NC}"
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo ""
            echo -e "${RED}Attempted merge: '$MERGE_SOURCE' -> '$CURRENT_BRANCH'${NC}"
            echo ""
            echo -e "${RED}This merge is forbidden by the project rules.${NC}"
            echo ""
            echo -e "${YELLOW}Abort this merge with:${NC}"
            echo -e "  ${CYAN}git merge --abort${NC}"
            echo ""
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo ""
            exit 1
        fi
    done
fi

# If we reach here, the merge is allowed
exit 0
